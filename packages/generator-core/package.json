    "@types/semver": "^7.8.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
