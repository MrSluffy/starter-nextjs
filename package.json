{
  "name": "starter-nextjs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/generator-core && npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace=packages/generator-core",
    "build:web": "npm run build --workspace=apps/web",
    "build:mcp": "npm run build --workspace=apps/mcp",
    "vercel-build": "npm run build:core && npm run build:web",
    "start": "npm run start --workspace=apps/web",
    "dev": "npm run dev --workspace=apps/web",
    "dev:mcp": "npm run mcp --workspace=apps/mcp",
    "publish:mcp": "npm run build:core && npm run test:mcp && npm run build:mcp && npm publish --workspace=@mrsluffy/starter-nextjs-mcp --access public",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace=apps/web",
    "test:mcp": "npm run test --workspace=apps/mcp",
    "test:core": "npm run test --workspace=packages/generator-core",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
